APP_NAME=Criptografy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Propositalmente ausente: DB_CONNECTION, DB_HOST, DB_DATABASE, etc.
# O MVP não possui banco de dados (ver Secao 18 da especificação).

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file

VITE_APP_NAME="${APP_NAME}"
