APP_NAME=Criptografy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Propositalmente ausente: DB_CONNECTION, DB_HOST, DB_DATABASE, etc.
# O MVP não possui banco de dados (ver Secao 18 da especificação).

# A API não usa sessão (nenhuma rota está no grupo "web").
SESSION_DRIVER=array

# Usado pelo rate limit. "array" não persiste entre requisições e anularia o limite.
CACHE_STORE=file

# Requisições por minuto, por IP, nas rotas da API.
API_RATE_LIMIT=60
