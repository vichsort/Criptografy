APP_NAME=Criptografy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Deliberately absent: DB_CONNECTION, DB_HOST, DB_DATABASE, etc.
# The API is stateless and has no database.

# The API uses no sessions (no route is in the "web" group).
SESSION_DRIVER=array

# Used by the rate limiter. "array" does not persist across requests and would disable the limit.
CACHE_STORE=file

# Requests per minute, per IP, on the API routes.
API_RATE_LIMIT=60
